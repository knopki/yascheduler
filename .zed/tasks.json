// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Init venv on worktree creation",
    "command": "uv",
    "args": ["sync", "--locked", "--all-extras"],
    "hooks": ["create_worktree"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus",
    "hide": "on_success",
  },
]
